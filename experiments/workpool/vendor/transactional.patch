 4 // Leave space for the work/payload reads and deletes, the completion record,
 5 // and waking the loop or scheduling failure completion. Byte reserves include
 6 // room for a large document crossing the nested call's limit.
 7 const COMPLETION_RESERVE = {
 8   bytesRead: 3 * 1024 * 1024,
 9   bytesWritten: 2 * 1024 * 1024,
10   databaseQueries: 32,
11   documentsRead: 32,
12   documentsWritten: 16,
13   functionsScheduled: 4,
14   scheduledFunctionArgsBytes: 1024 * 1024,
15 } satisfies TransactionLimits;
16 
17 export async function completionTransactionLimits(
18   ctx: MutationCtx,
19 ): Promise<TransactionLimits> {
20   const metrics = await ctx.meta.getTransactionMetrics();
21   const limits: TransactionLimits = {};
22   for (const key of Object.keys(
23     COMPLETION_RESERVE,
24   ) as (keyof typeof COMPLETION_RESERVE)[]) {
25     limits[key] = Math.max(0, metrics[key].remaining - COMPLETION_RESERVE[key]);
26   }
27   return limits;
28 }
