{
  "name": "@convex-dev/workflow",
  "version": "0.4.10",
  "description": "Convex component for durably executing workflows.",
  "keywords": [
    "convex",
    "workflow",
    "durable-execution"
  ],
  "homepage": "https://github.com/convex/workflow",
  "repository": "github:convex/workflow",
  "bugs": "https://github.com/convex/workflow/issues",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:backend": "convex dev --typecheck-components",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "convex init && (path-exists dist || npm run build)",
    "build": "tsc --project ./tsconfig.build.json",
    "prepack": "npm run build",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example/convex",
    "lint": "eslint .",
    "format": "prettier -w .",
    "format:check": "prettier --check .",
    "check": "run-p test typecheck lint format:check",
    "all": "run-p -r 'dev:*' 'test:watch'",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "test:e2e": "sh ./example/e2e.sh"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "@convex-dev/workpool": "^0.4.4",
    "convex": "^1.48.0",
    "convex-helpers": "^0.1.127"
  },
  "dependencies": {
    "async-channel": "^0.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@convex-dev/eslint-plugin": "5.0.0",
    "@convex-dev/workpool": "0.4.14",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "chokidar-cli": "3.0.0",
    "convex": "1.48.0",
    "convex-helpers": "0.1.128",
    "convex-test": "0.0.67",
    "cpy-cli": "7.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "npm-run-all2": "9.0.3",
    "openai": "7.32.0",
    "path-exists-cli": "2.0.0",
    "pkg-pr-new": "0.0.91",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
